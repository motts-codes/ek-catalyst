# Not part of the app: raw import data folders, hand-off docs, stray output dirs.
# (scripts/generate.cjs at the top level is needed by the build and stays.)
scripts/*/
undefined/
docs/
tests/
*.log

# Local dev-server logs.
nohup*.out

# Never upload local env files (secrets); the build reads Vercel env vars.
.env*.local
.env.local.*
